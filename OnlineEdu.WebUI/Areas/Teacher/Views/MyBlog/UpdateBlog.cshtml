@model UpdateBlogDto
@{
    ViewData["Title"] = "Blog Yazısını Düzenle";
    Layout = "~/Areas/Teacher/Views/TeacherLayout/Index.cshtml";
}
<form method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="BlogId" />
    <input type="hidden" asp-for="BlogDate" />
    <input type="hidden" asp-for="WriterId" />
    <label>Başlık</label>
    <input type="text" asp-for="Title" class="form-control" />
    <span asp-validation-for="Title" class="text-danger"></span>
    <br />

    <label>İçerik</label>
    <textarea asp-for="Content" class="form-control" rows="5"></textarea>
    <br />

    <label>Görsel URL</label>
    <input type="text" asp-for="ImageUrl" class="form-control" />
    <small class="text-muted d-block mt-1">Bir görsel adresi girin veya aşağıdan bilgisayarınızdan yükleyin (Cloudinary CDN'e yüklenir).</small>
    <input type="file" name="imageFile" class="form-control mt-2" accept="image/*" />
    <br />

    <label>Kategori</label>
    <select asp-items="@ViewBag.categories" asp-for="BlogCategoryId" class="form-control">
        <option>Kategori Seçin</option>
    </select>
    <br />
    <button type="submit" class="btn btn-outline-primary">Kaydet</button>
</form>
