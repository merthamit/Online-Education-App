@model CreateCourseCategoryDto
@{
    ViewData["Title"] = "Yeni Kurs Kategorisi";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<form method="post">
    <label>Kategori Adı</label>
    <input type="text" asp-for="CategoryName" class="form-control" />
    <br />

    <label>Açıklama</label>
    <textarea type="text" asp-for="Description" class="form-control" rows="3"></textarea>
    <br />

    <label>İkon (Font Awesome sınıfı, ör. fab fa-twitter)</label>
    <input type="text" asp-for="Icon" class="form-control" />
    <br />

    <label>Ana Sayfada Gösterilsin mi?</label>
    <input type="checkbox" asp-for="IsShown" class="form-check" />
    <br />

    <button type="submit" class="btn btn-outline-primary">Kaydet</button>
</form>

