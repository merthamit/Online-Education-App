@model CreateMessageDto
@{
    ViewData["Title"] = "Yeni Mesaj";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<form method="post">
    <label>Ad Soyad</label>
    <input type="text" asp-for="Name" class="form-control" />
    <span asp-validation-for="Name" class="text-danger"></span>
    <br />

    <label>E-posta</label>
    <input type="text" asp-for="Email" class="form-control" />
    <br />

    <label>Konu</label>
    <input type="text" asp-for="Subject" class="form-control" />
    <br />

    <textarea asp-for="Content" class="form-control" rows="3"></textarea>

    <button type="submit" class="btn btn-outline-primary">Kaydet</button>
</form>
