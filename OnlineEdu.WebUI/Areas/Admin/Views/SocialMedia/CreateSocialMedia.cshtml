@model CreateSocialMediaDto
@{
    ViewData["Title"] = "Yeni Sosyal Medya Hesabı";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<form method="post">
    <label>Başlık</label>
    <input type="text" asp-for="Title" class="form-control"/>
    <br />

    <label>İkon (Font Awesome sınıfı, ör. fab fa-twitter)</label>
    <input type="text" asp-for="Icon" class="form-control" />
    <br />

    <label>Bağlantı (URL)</label>
    <input type="text" asp-for="Url" class="form-control" />
    <br />

    <button type="submit" class="btn btn-outline-primary">Kaydet</button>
</form>
