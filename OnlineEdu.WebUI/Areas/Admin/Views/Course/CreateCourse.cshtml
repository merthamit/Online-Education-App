@model CreateCourseDto
@{
    ViewData["Title"] = "Yeni Kurs";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<form method="post" enctype="multipart/form-data">
    <label>Kurs Adı</label>
    <input type="text" asp-for="CourseName" class="form-control" />
    <span asp-validation-for="CourseName" class="text-danger"></span>
    <br />

    <label>Resim Yükle (Cloudinary üzerinden yayınlanacak)</label>
    <input type="file" name="imageFile" class="form-control" accept="image/*" />
    <input type="hidden" asp-for="ImageUrl" value="" />
    <br />

    <label>Fiyat (₺)</label>
    <input type="text" asp-for="Price" class="form-control" />
    <br />

    <label>Kategori</label>
    <select asp-items="@ViewBag.courseCategories" asp-for="CourseCategoryId" class="form-control">
        <option>Kategori Seçin</option>
    </select>
    <br />

    <label>Ana Sayfada Gösterilsin mi?</label>
    <input type="checkbox" asp-for="IsShown" class="form-check" />
    <br />
    <button type="submit" class="btn btn-outline-primary">Kaydet</button>
</form>
