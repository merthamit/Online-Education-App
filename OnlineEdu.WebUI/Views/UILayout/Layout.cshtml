@{
    Layout = null;
}

<!doctype html>
<html class="no-js" lang="zxx">
<head>
<style>html, body { overflow-x: hidden; }</style>
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <title> Education | Template </title>
    <meta name="description" content="">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="shortcut icon" type="image/x-icon" href="assets/img/favicon.ico">

    <!-- CSS here -->
    <link rel="stylesheet" href="~/onlineedu-master/assets/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/onlineedu-master/assets/css/owl.carousel.min.css">
    <link rel="stylesheet" href="~/onlineedu-master/assets/css/slicknav.css">
    <link rel="stylesheet" href="~/onlineedu-master/assets/css/flaticon.css">
    <link rel="stylesheet" href="~/onlineedu-master/assets/css/gijgo.css">
    <link rel="stylesheet" href="~/onlineedu-master/assets/css/animate.min.css">
    <link rel="stylesheet" href="~/onlineedu-master/assets/css/magnific-popup.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <link rel="stylesheet" href="~/onlineedu-master/assets/css/themify-icons.css">
    <link rel="stylesheet" href="~/onlineedu-master/assets/css/slick.css">
    <link rel="stylesheet" href="~/onlineedu-master/assets/css/nice-select.css">
    <link rel="stylesheet" href="~/onlineedu-master/assets/css/style.css">
    <link rel="stylesheet" href="~/css/onlineedu-custom.css" asp-append-version="true">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@48,400,0,0">
</head>
<body>
    <!--? Preloader Start -->
    <div id="preloader-active">
        <div class="preloader d-flex align-items-center justify-content-center">
            <div class="preloader-inner position-relative">
                <div class="preloader-circle"></div>
                <div class="preloader-img pere-text">
                    <img src="~/onlineedu-master/assets/img/logo/loder.png" alt="">
                </div>
            </div>
        </div>
    </div>
    <!-- Preloader Start -->
    <header>
        <!-- Header Start -->
        <div class="header-area">
            <div class="main-header ">
                <div class="header-top d-none d-lg-block">
                    <!-- Left Social -->
                    @await Component.InvokeAsync("_UILayoutHeaderSocialMediaComponent")

                    <div class="container">
                        <div class="col-xl-12">
                            <div class="row d-flex justify-content-between align-items-center">

                                @await Component.InvokeAsync("_UILayoutHeaderContactInfoComponent")

                                                                <div class="header-info-right">
                                    <ul>
                                        @if (User.Identity.IsAuthenticated)
                                        {
                                            var fullName = User.Claims.FirstOrDefault(x => x.Type == "fullName")?.Value ?? User.Identity.Name;
                                            var role = User.Claims.FirstOrDefault(x => x.Type == System.Security.Claims.ClaimTypes.Role)?.Value;
                                            var userId = User.Claims.FirstOrDefault(x => x.Type == System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
                                            var roleName = role switch { "Admin" => "Yönetici", "Teacher" => "Eğitmen", _ => "Öğrenci" };
                                            var initials = string.Concat((fullName ?? "?").Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => char.ToUpper(x[0])));
                                            <li class="oe-user-menu">
                                                <button type="button" class="oe-user-toggle" aria-haspopup="true" aria-expanded="false">
                                                    <span class="oe-user-avatar">@initials</span>
                                                    <span class="oe-user-name">@fullName</span>
                                                    <i class="fas fa-chevron-down"></i>
                                                </button>
                                                <div class="oe-user-dropdown" role="menu">
                                                    <div class="oe-user-head">
                                                        <span class="oe-user-avatar lg">@initials</span>
                                                        <div><strong>@fullName</strong><small>@roleName</small></div>
                                                    </div>
                                                    @if (role == "Admin")
                                                    {
                                                        <a href="/Admin/Dashboard/Index"><i class="fas fa-tachometer-alt"></i> Yönetim Paneli</a>
                                                    }
                                                    @if (role == "Teacher")
                                                    {
                                                        <a href="/Course/Index?teacher=@userId"><i class="fas fa-id-badge"></i> Eğitmen Sayfam</a>
                                                        <a href="/Teacher/MyCourse/CreateCourse"><i class="fas fa-plus-circle"></i> Kurs Aç</a>
                                                        <a href="/Teacher/MyCourse/Index"><i class="fas fa-chalkboard"></i> Eğitmen Paneli</a>
                                                    }
                                                    @if (role == "Student")
                                                    {
                                                        <a href="/MyCourses/Index"><i class="fas fa-book-reader"></i> Kayıt Olduğum Kurslar</a>
                                                        <a href="/TeacherApplication/Index"><i class="fas fa-chalkboard-teacher"></i> Eğitmen Ol</a>
                                                    }
                                                    <a href="/Setting/Index"><i class="fas fa-user-cog"></i> Profil Ayarları</a>
                                                    <div class="oe-user-sep"></div>
                                                    <a href="/Login/Logout" class="danger"><i class="fas fa-sign-out-alt"></i> Çıkış Yap</a>
                                                </div>
                                            </li>
                                        }
                                        else
                                        {
                                            <li><a href="/Login/SignIn" class="oe-top-link"><i class="fas fa-sign-in-alt"></i> Giriş Yap</a></li>
                                            <li><a href="/Register/Signup" class="oe-top-cta">Ücretsiz Kayıt Ol</a></li>
                                        }
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="header-bottom header-sticky">
                    <!-- Logo -->
                    <div class="logo d-none d-lg-block">
                        <a href="/Home/Index"><img src="~/onlineedu-master/assets/img/logo/logo.png" alt=""></a>
                    </div>
                    <div class="container">
                        <div class="menu-wrapper">
                            <!-- Logo -->
                            <div class="logo logo2 d-block d-lg-none">
                                <a href="/Home/Index"><img src="~/onlineedu-master/assets/img/logo/logo.png" alt=""></a>
                            </div>
                            <!-- Main-menu -->
                            <div class="main-menu d-none d-lg-block">
                                <nav>
                                    <ul id="navigation">
                                        <li><a href="/Home/Index">Ana Sayfa</a></li>
                                        <li><a href="/About/Index">Hakkımızda</a></li>
                                        <li><a href="/Course/Index">Kurslar</a></li>
                                        <li><a href="/Teacher/Index">Eğitmenler</a></li>
                                        <li>
                                            <a href="/Blog/Index">Blog</a>

                                        </li>
                                        <li><a href="/Contact/Index">İletişim</a></li>
                                    </ul>
                                </nav>
                            </div>
                            <!-- Header-btn -->
                            <div class="header-search d-none d-lg-block">
                                <form action="/Course/Index" method="get" class="form-box f-right ">
                                    <input type="text" name="search" value="@Context.Request.Query["search"]" placeholder="Kurs Ara..." required>
                                    <button type="submit" class="search-icon" style="border: 0; cursor: pointer;" aria-label="Kurs ara">
                                        <i class="fas fa-search special-tag"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                        <!-- Mobile Menu -->
                        <div class="col-12">
                            <div class="mobile_menu d-block d-lg-none"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Header End -->
    </header>
    <main>
        @RenderBody()


    </main>
    <footer>
        <!--? Footer Start-->
        <div class="footer-area footer-bg">
            <div class="container">
                <div class="footer-top footer-padding">
                    <!-- footer Heading -->
                    <div class="footer-heading">
                        <div class="row justify-content-between">
                            <div class="col-xl-6 col-lg-7 col-md-10">
                                <div class="footer-tittle2">
                                    <h4>Bültenimize Abone Olun</h4>
                                </div>
                                <!-- Form -->
                                @await Component.InvokeAsync("_LayoutSubscribeComponent") 
                            </div>
                            <div class="col-xl-5 col-lg-5">
                                <div class="footer-tittle2">
                                    <h4>Let’s Get Social</h4>
                                </div>
                                <!-- Footer Social -->
                                @await Component.InvokeAsync("_UILayoutSocialMedia")
                            </div>
                        </div>
                    </div>
                    <!-- Footer Menu -->
                    <div class="row d-flex justify-content-between">
                        <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6">
                            <div class="single-footer-caption mb-50">
                                <div class="footer-tittle">
                                    <h4>Hakkımızda</h4>
                                    <ul>
                                        <li><a href="/Course/Index">Kurslarımız</a></li>
                                        <li><a href="/About/Index">Hakkımızda</a></li>
                                        <li><a href="/Blog/Index">Bloglar</a></li>
                                        <li><a href="/Contact/Index">İletişim</a></li>
                                        <li><a href="/Teacher/Index">Eğitmenler</a></li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                        <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6">
                            <div class="single-footer-caption mb-50">
                                <div class="footer-tittle">
                                    <h4>İçeriklerimiz</h4>
                                    <ul>
                                        <li><a href="#">Kurslarımız</a></li>
                                        <li><a href="#">Ücretsiz Kurslar</a></li>
                                        <li><a href="#">Akademik Çözümler</a></li>
                                        <li><a href="#">İş Çözümleri</a></li>

                                    </ul>
                                </div>
                            </div>
                        </div>
                        <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6">
                            <div class="single-footer-caption mb-50">
                                <div class="footer-tittle">
                                    <h4>Çalışma Planı</h4>
                                    <ul>
                                        <li><a href="#">Kayıt Politikası</a></li>
                                        <li><a href="#">Başlangıç Aşaması</a></li>
                                        <li><a href="#">Online Başvuru</a></li>
                                        <li><a href="#">Soru Cevap Etkinliği</a></li>
                                        <li><a href="#">Ücretsiz Rehberlik</a></li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                        <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6">
                            <div class="single-footer-caption mb-50">
                                <div class="footer-tittle">
                                    <h4>Destek</h4>
                                    <ul>
                                        <li><a href="#">Destek</a></li>
                                        <li><a href="/Contact/Index">İletişim</a></li>
                                        <li><a href="#">Sistem Gereksinimleri</a></li>
                                        <li><a href="/Register/Signup">Ücretsiz Kaydolun</a></li>
                                        <li><a href="#">Geri Dönütler</a></li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Footer Bottom -->
                <div class="footer-bottom">
                    <div class="row d-flex align-items-center">
                        <div class="col-lg-12">
                            <div class="footer-copy-right text-center">
                                <p>Copyright &copy;<script>document.write(new Date().getFullYear());</script> Tüm Hakları Saklıdır | Made with <i class="fa fa-heart" aria-hidden="true" style="color: #007bff;"></i> by Mert</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Footer End-->
    </footer>
    <!-- Scroll Up -->
    <div id="back-top">
        <a title="Go to Top" href="#"> <i class="fas fa-level-up-alt"></i></a>
    </div>

    <!-- JS here -->

    <script src="~/onlineedu-master/assets/js/vendor/modernizr-3.5.0.min.js"></script>
    <!-- Jquery, Popper, Bootstrap -->
    <script src="~/onlineedu-master/assets/js/vendor/jquery-1.12.4.min.js"></script>
    <script src="~/onlineedu-master/assets/js/popper.min.js"></script>
    <script src="~/onlineedu-master/assets/js/bootstrap.min.js"></script>
    <script src="~/onlineedu-master/assets/js/jquery.slicknav.min.js"></script>
    <script src="~/onlineedu-master/assets/js/owl.carousel.min.js"></script>
    <script src="~/onlineedu-master/assets/js/slick.min.js"></script>
    <script src="~/onlineedu-master/assets/js/wow.min.js"></script>
    <script src="~/onlineedu-master/assets/js/animated.headline.js"></script>
    <script src="~/onlineedu-master/assets/js/jquery.magnific-popup.js"></script>
    <script src="~/onlineedu-master/assets/js/gijgo.min.js"></script>
    <script src="~/onlineedu-master/assets/js/jquery.nice-select.min.js"></script>
    <script src="~/onlineedu-master/assets/js/jquery.sticky.js"></script>
    <script src="~/onlineedu-master/assets/js/jquery.counterup.min.js"></script>
    <script src="~/onlineedu-master/assets/js/waypoints.min.js"></script>
    <script src="~/onlineedu-master/assets/js/contact.js"></script>
    <script src="~/onlineedu-master/assets/js/jquery.form.js"></script>
    <script src="~/onlineedu-master/assets/js/jquery.validate.min.js"></script>
    <script src="~/onlineedu-master/assets/js/mail-script.js"></script>
    <script src="~/onlineedu-master/assets/js/jquery.ajaxchimp.min.js"></script>
    <script src="~/onlineedu-master/assets/js/plugins.js"></script>
    <script src="~/onlineedu-master/assets/js/main.js"></script>
    <script src="~/Login & Signup Form/script.js" defer></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>

        function subscribe() {



            Swal.fire({
                title: "Abone Olma İşlemi Başarılı",
                text: "Abone olduğunuz için teşekkürler",
                icon: "success",
                showCancelButton: false,
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#d33",
                confirmButtonText: "Tamam",
                cancelButtonText: "İptal"
            }).then((result) => {
                if (result.isConfirmed) {

                    window.location.href = "/Blog/Index";

                }
            });

        }

    </script>

<script>
    // Üst bardaki kullanıcı menüsü
    (function () {
        var menu = document.querySelector('.oe-user-menu');
        if (!menu) return;
        var btn = menu.querySelector('.oe-user-toggle');
        btn.addEventListener('click', function (e) {
            e.stopPropagation();
            var open = menu.classList.toggle('open');
            btn.setAttribute('aria-expanded', open);
        });
        document.addEventListener('click', function (e) { if (!menu.contains(e.target)) { menu.classList.remove('open'); btn.setAttribute('aria-expanded', 'false'); } });
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape') menu.classList.remove('open'); });
    })();
</script>
</body>
</html>