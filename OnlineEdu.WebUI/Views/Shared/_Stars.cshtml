@model double
@{
    // 0-5 arası puanı tam / yarım / boş yıldızlarla gösterir
    var full = (int)Math.Floor(Model);
    var half = Model - full >= 0.5;
}
<span class="oe-stars" aria-label="5 üzerinden @Model.ToString("0.0") puan">
    @for (int i = 1; i <= 5; i++)
    {
        if (i <= full)
        {
            <i class="fas fa-star"></i>
        }
        else if (i == full + 1 && half)
        {
            <i class="fas fa-star-half-alt"></i>
        }
        else
        {
            <i class="far fa-star"></i>
        }
    }
</span>
