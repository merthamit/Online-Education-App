@model List<ResultUserDto>

<section class="oe-team-section">
    <div class="container">
        <div class="text-center mb-5">
            <span class="oe-eyebrow">Eğitmenlerimiz</span>
            <h2 class="oe-section-title">Alanında uzman eğitim kadromuz</h2>
        </div>
        <div class="row oe-grid">
            @foreach (var item in Model)
            {
                <div class="col-lg-3 col-md-6">
                    <partial name="_TeacherCard" model="item" />
                </div>
            }
        </div>
        <div class="text-center mt-3">
            <a href="/Teacher/Index" class="oe-btn-outline">Tüm Eğitmenleri Gör <i class="fas fa-arrow-right"></i></a>
        </div>
    </div>
</section>
