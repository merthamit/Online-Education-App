@model List<ResultCourseCategoryDto>

<div class="categories-area section-padding30">
    <div class="container">
        <div class="row justify-content-sm-center">
            <div class="cl-xl-7 col-lg-8 col-md-10">
                <!-- Section Title -->
                <div class="section-tittle text-center mb-70">
                    <span>Kurs Kategorilerimiz</span>
                    <h2>Popüler Kategorilere Göz Atın</h2>
                </div>
            </div>
        </div>
        <div class="row oe-grid">
            @foreach (var item in Model.Take(6))
            {
                <div class="col-lg-4 col-md-6">
                    <div class="oe-cat-card">
                        <div class="oe-cat-icon"><i class="@item.Icon"></i></div>
                        <h5><a href="/Course/Index?category=@item.CourseCategoryId">@item.CategoryName</a></h5>
                        <p>@(item.Description?.Length > 100 ? item.Description.Substring(0, 100) + "..." : item.Description)</p>
                        <a href="/Course/Index?category=@item.CourseCategoryId" class="oe-cat-link">Kursları İncele <i class="fas fa-arrow-right"></i></a>
                    </div>
                </div>
            }
        </div>
        <!-- Section Button -->
        <div class="row">
            <div class="col-lg-12">
                <div class="text-center mt-30">
                    <a href="/Course/Index" class="oe-btn-outline">Tüm Kurslara Göz Atın <i class="fas fa-arrow-right"></i></a>
                </div>
            </div>
        </div>
    </div>
</div>