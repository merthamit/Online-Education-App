@model List<ResultBlogDto>

<div class="col-lg-8 mb-5 mb-lg-0">
    <div class="blog_left_sidebar">
        @if (ViewBag.Search != null)
        {
            <div class="alert alert-info mb-4">
                <strong>"@ViewBag.Search"</strong> için @ViewBag.ResultCount sonuç bulundu.
                <a href="/Blog/Index" class="ml-2">Tüm yazılara dön</a>
            </div>
        }
        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="ti-search" style="font-size: 48px; color: #ccc;"></i>
                <h4 class="mt-3">Aramanızla eşleşen bir yazı bulunamadı</h4>
                <p>Farklı bir kelime deneyin.</p>
            </div>
        }
        @foreach (var item in Model)
        {

            <article class="blog_item">
                <div class="blog_item_img">
                    <img class="card-img rounded-0" src="@item.ImageUrl" alt="">
                    <a href="#" class="blog_item_date">
                        <h3>@item.BlogDate.Day</h3>
                        <p>@item.BlogDate.ToString("MMM")</p>
                    </a>
                </div>
                <div class="blog_details">
                    <a class="d-inline-block" href="/Blog/BlogDetails/@item.BlogId">
                        <h2 class="blog-head" style="color: #2d2d2d;">@item.Title</h2>
                    </a>
                    <p>
                        @((item.Content ?? "").Length > 50
                                            ? item.Content.Substring(0, 50) + "..."
                                            : item.Content)
                    </p>
                    <ul class="blog-info-link">
                        @if (item.Writer != null && item.WriterId != null)
                        {
                            <li><a href="/Course/Index?teacher=@item.WriterId"><i class="fa fa-user"></i> @item.Writer.FirstName @item.Writer.LastName</a></li>
                        }
                        else
                        {
                            <li><a href="#"><i class="fa fa-user"></i> Yazar Yok</a></li>
                        }
                        <li><a href="#"><i class="fa fa-list-ol"></i> @(item.BlogCategory?.Name)</a></li>
                    </ul>
                </div>
            </article>
        }

        @await Html.PartialAsync("_Pagination", (PaginationViewModel)ViewBag.Pagination)
    </div>
</div>