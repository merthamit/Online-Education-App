@model List<ResulBannerDto>
<div class="slider-area ">
    @foreach(var item in Model)
    {
        <div class="slider-active">
            <!-- Single Slider -->
            <div class="single-slider slider-height d-flex align-items-center">
                <div class="container">
                    <div class="row align-items-center">
                        <div class="col-xl-6 col-lg-7 col-md-8">
                            <div class="hero__caption">
                                <span data-animation="fadeInLeft" data-delay=".2s">Popüler Online Kurslar</span>
                                <h1 data-animation="fadeInLeft" data-delay=".4s">@item.Title</h1>
                                <!-- Hero-btn -->
                                <div class="hero__btn">
                                    <a href="/Course/Index" class="btn hero-btn" data-animation="fadeInLeft" data-delay=".8s">Hemen Başla</a>
                                </div>
                            </div>
                        </div>
                        <div class="col-xl-6 col-lg-5">
                            <div class="hero-man oe-hero-img d-none d-lg-block f-right" data-animation="fadeInRight" data-delay=".4s">
                                <img src="@item.ImageUrl" alt="@item.Title">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>