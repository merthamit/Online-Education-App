@{
    Layout = null;

    // Paneller (Admin / Öğretmen / Öğrenci) bu ortak layout'u kullanır; Teacher ve Student layout'ları ViewData["Panel"] belirler
    var panel = ViewData["Panel"] as string ?? "Admin";
    var fullName = User.Claims.FirstOrDefault(x => x.Type == "fullName")?.Value ?? User.Identity?.Name ?? "Kullanıcı";
    var initials = string.Concat(fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => char.ToUpper(x[0])));

    var (panelTitle, homeUrl) = panel switch
    {
        "Teacher" => ("Eğitmen Paneli", "/Teacher/MyCourse/Index"),
        "Student" => ("Öğrenci Paneli", "/MyCourses/Index"),
        _ => ("Yönetim Paneli", "/Admin/Dashboard/Index")
    };

    var menu = panel switch
    {
        "Teacher" => new List<(string Title, string Icon, string Url, string Group)>
        {
            ("Kurslarım", "mdi-keyboard", "/Teacher/MyCourse/Index", "Menü"),
            ("Bloglarım", "mdi-newspaper", "/Teacher/MyBlog/Index", "Menü"),
            ("Sosyal Medyalarım", "mdi-linkedin-box", "/Teacher/MySocialMedia/Index", "Menü"),
            ("Profil Bilgileri", "mdi-account-circle", "/Setting/Index", "Menü"),
        },
        "Student" => new List<(string Title, string Icon, string Url, string Group)>
        {
            ("Kayıt Olduğum Kurslar", "mdi-school", "/MyCourses/Index", "Menü"),
            ("Eğitmen Ol", "mdi-account-star", "/TeacherApplication/Index", "Menü"),
            ("Kurs Kayıtlarım", "mdi-format-list-bulleted", "/Student/CourseRegister/Index", "Menü"),
            ("Yeni Kursa Kaydol", "mdi-plus-circle", "/Course/Index", "Menü"),
            ("Profil Bilgileri", "mdi-account-circle", "/Setting/Index", "Menü"),
        },
        _ => new List<(string Title, string Icon, string Url, string Group)>
        {
            ("Dashboard", "mdi-view-dashboard", "/Admin/Dashboard/Index", "Genel"),
            ("Hakkımızda", "mdi-information-outline", "/Admin/About/Index", "İçerik"),
            ("Banner", "mdi-image", "/Admin/Banner/Index", "İçerik"),
            ("Blog Kategorileri", "mdi-format-list-numbers", "/Admin/BlogCategory/Index", "İçerik"),
            ("Bloglar", "mdi-newspaper", "/Admin/Blog/Index", "İçerik"),
            ("İletişim Bilgisi", "mdi-phone", "/Admin/Contact/Index", "İçerik"),
            ("Kurs Kategorileri", "mdi-playlist-play", "/Admin/CourseCategory/Index", "Kurs Yönetimi"),
            ("Kurslar", "mdi-keyboard", "/Admin/Course/Index", "Kurs Yönetimi"),
            ("Tüm Kullanıcılar", "mdi-account-multiple-outline", "/Admin/RoleAssign/Index", "Kullanıcılar"),
            ("Eğitmenler", "mdi-account-star", "/Admin/TeacherList/Index", "Kullanıcılar"),
            ("Öğrenciler", "mdi-account", "/Admin/StudentList/Index", "Kullanıcılar"),
            ("Roller", "mdi-account-key", "/Admin/Role/Index", "Kullanıcılar"),
            ("Eğitmen Başvuruları", "mdi-account-plus", "/Admin/TeacherApplication/Index", "Kullanıcılar"),
            ("Gelen Mesajlar", "mdi-comment", "/Admin/Message/Index", "İletişim"),
            ("Sosyal Medya", "mdi-linkedin-box", "/Admin/SocialMedia/Index", "İletişim"),
            ("Aboneler", "mdi-account-multiple", "/Admin/Subscriber/Index", "İletişim"),
            ("Referanslar", "mdi-format-quote", "/Admin/Testimonial/Index", "İletişim"),
        }
    };

    var quickAdd = panel switch
    {
        "Teacher" => new List<(string Title, string Icon, string Url, string Group)>
        {
            ("Yeni Kurs", "mdi-keyboard", "/Teacher/MyCourse/CreateCourse", "Hızlı Ekle"),
            ("Yeni Blog", "mdi-newspaper", "/Teacher/MyBlog/CreateBlog", "Hızlı Ekle"),
            ("Yeni Sosyal Medya", "mdi-linkedin-box", "/Teacher/MySocialMedia/CreateTeacherSocial", "Hızlı Ekle"),
        },
        "Student" => new List<(string Title, string Icon, string Url, string Group)>
        {
            ("Kursa Kaydol", "mdi-plus-circle", "/Course/Index", "Hızlı Ekle"),
        },
        _ => new List<(string Title, string Icon, string Url, string Group)>
        {
            ("Yeni Kurs", "mdi-keyboard", "/Admin/Course/CreateCourse", "Hızlı Ekle"),
            ("Yeni Blog", "mdi-newspaper", "/Admin/Blog/CreateBlog", "Hızlı Ekle"),
            ("Yeni Kurs Kategorisi", "mdi-playlist-play", "/Admin/CourseCategory/CreateCourseCategory", "Hızlı Ekle"),
            ("Yeni Blog Kategorisi", "mdi-format-list-numbers", "/Admin/BlogCategory/CreateBlogCategory", "Hızlı Ekle"),
            ("Yeni Banner", "mdi-image", "/Admin/Banner/CreateBanner", "Hızlı Ekle"),
            ("Yeni Referans", "mdi-format-quote", "/Admin/Testimonial/CreateTestimonial", "Hızlı Ekle"),
            ("Yeni Rol", "mdi-account-key", "/Admin/Role/CreateRole", "Hızlı Ekle"),
        }
    };

    // Arama paleti: menü + hızlı ekleme + genel sayfalar
    var searchItems = menu.Select(x => new { title = x.Title, icon = x.Icon, url = x.Url, group = "Sayfalar" })
        .Concat(quickAdd.Select(x => new { title = x.Title, icon = x.Icon, url = x.Url, group = "Hızlı Ekle" }))
        .Concat(new[]
        {
            new { title = "Siteye Git", icon = "mdi-laptop", url = "/Home/Index", group = "Genel" },
            new { title = "Profil Ayarları", icon = "mdi-settings", url = "/Setting/Index", group = "Genel" },
            new { title = "Çıkış Yap", icon = "mdi-logout", url = "/Login/Logout", group = "Genel" },
        })
        .GroupBy(x => x.url).Select(g => g.First());
    var searchJson = System.Text.Json.JsonSerializer.Serialize(searchItems);
}
<!DOCTYPE html>
<html dir="ltr" lang="tr">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" type="image/png" sizes="16x16" href="~/matrix-admin-master/assets/images/favicon.png">
    <title>@ViewData["Title"] - @panelTitle | Mert Admin</title>
    <link href="~/matrix-admin-master/assets/libs/magnific-popup/dist/magnific-popup.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <link href="~/matrix-admin-master/dist/css/style.min.css" rel="stylesheet">
    <link href="~/css/panel.css" rel="stylesheet" asp-append-version="true">
</head>

<body>
    <div class="preloader">
        <div class="lds-ripple">
            <div class="lds-pos"></div>
            <div class="lds-pos"></div>
        </div>
    </div>
    <div id="main-wrapper">
        <header class="topbar" data-navbarbg="skin5">
            <nav class="navbar top-navbar navbar-expand-md navbar-dark">
                <div class="navbar-header" data-logobg="skin5">
                    <a class="nav-toggler waves-effect waves-light d-block d-md-none" href="javascript:void(0)"><i class="ti-menu ti-close"></i></a>
                    <a class="navbar-brand mert-brand" href="@homeUrl">
                        <b class="logo-icon p-l-10">
                            <img src="~/matrix-admin-master/assets/images/logo-icon.png" alt="Mert Admin" class="light-logo" />
                        </b>
                        <span class="logo-text">Mert <strong>Admin</strong></span>
                    </a>
                    <a class="topbartoggler d-block d-md-none waves-effect waves-light" href="javascript:void(0)" data-toggle="collapse" data-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Menüyü aç"><i class="ti-more"></i></a>
                </div>
                <div class="navbar-collapse collapse" id="navbarSupportedContent" data-navbarbg="skin5">
                    <ul class="navbar-nav float-left mr-auto align-items-center">
                        <li class="nav-item d-none d-md-block"><a class="nav-link sidebartoggler waves-effect waves-light" href="javascript:void(0)" data-sidebartype="mini-sidebar"><i class="mdi mdi-menu font-24"></i></a></li>
                        @if (quickAdd.Any())
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="quickAddDropdown" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                    <span class="d-none d-md-block"><i class="fa fa-plus-circle"></i> Hızlı Ekle <i class="fa fa-angle-down"></i></span>
                                    <span class="d-block d-md-none"><i class="fa fa-plus"></i></span>
                                </a>
                                <div class="dropdown-menu" aria-labelledby="quickAddDropdown">
                                    @foreach (var item in quickAdd)
                                    {
                                        <a class="dropdown-item" href="@item.Url"><i class="mdi @item.Icon m-r-5"></i> @item.Title</a>
                                    }
                                </div>
                            </li>
                        }
                        <li class="nav-item panel-search">
                            <div class="panel-search-box">
                                <i class="ti-search"></i>
                                <input type="text" id="panelSearch" placeholder="Panelde ara...  ( / )" autocomplete="off" aria-label="Panelde ara">
                                <div class="panel-search-results" id="panelSearchResults" role="listbox"></div>
                            </div>
                        </li>
                    </ul>
                    <ul class="navbar-nav float-right">
                        <li class="nav-item">
                            <a class="nav-link waves-effect waves-dark" href="/Home/Index" title="Siteye Git"><i class="mdi mdi-laptop font-24"></i></a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle waves-effect waves-dark d-flex align-items-center" href="" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                <span class="panel-avatar">@initials</span>
                                <span class="d-none d-lg-inline m-l-10 panel-username">@fullName</span>
                            </a>
                            <div class="dropdown-menu dropdown-menu-right user-dd animated">
                                <div class="p-15 border-bottom">
                                    <strong>@fullName</strong><br />
                                    <small class="text-muted">@panelTitle</small>
                                </div>
                                <a class="dropdown-item" href="/Setting/Index"><i class="ti-user m-r-5 m-l-5"></i> Profilim</a>
                                <a class="dropdown-item" href="/Home/Index"><i class="ti-world m-r-5 m-l-5"></i> Siteye Git</a>
                                <div class="dropdown-divider"></div>
                                <a class="dropdown-item" href="/Login/Logout"><i class="fa fa-power-off m-r-5 m-l-5"></i> Çıkış Yap</a>
                            </div>
                        </li>
                    </ul>
                </div>
            </nav>
        </header>

        <aside class="left-sidebar" data-sidebarbg="skin5">
            <div class="scroll-sidebar">
                <nav class="sidebar-nav">
                    <ul id="sidebarnav" class="p-t-30">
                        @{ string? lastGroup = null; }
                        @foreach (var item in menu)
                        {
                            if (item.Group != lastGroup)
                            {
                                lastGroup = item.Group;
                                <li class="panel-nav-cap"><span class="hide-menu">@item.Group</span></li>
                            }
                            <li class="sidebar-item"><a class="sidebar-link waves-effect waves-dark panel-menu-link" href="@item.Url" aria-expanded="false"><i class="mdi @item.Icon"></i><span class="hide-menu">@item.Title</span></a></li>
                        }
                        <li class="panel-nav-cap"><span class="hide-menu">Diğer</span></li>
                        <li class="sidebar-item"><a class="sidebar-link waves-effect waves-dark" href="/Home/Index" aria-expanded="false"><i class="mdi mdi-open-in-new"></i><span class="hide-menu">Siteye Git</span></a></li>
                        <li class="sidebar-item"><a class="sidebar-link waves-effect waves-dark" href="/Login/Logout" aria-expanded="false"><i class="mdi mdi-logout"></i><span class="hide-menu">Çıkış Yap</span></a></li>
                    </ul>
                </nav>
            </div>
        </aside>

        <div class="page-wrapper">
            <div class="page-breadcrumb">
                <div class="row">
                    <div class="col-12 d-flex no-block align-items-center">
                        <h4 class="page-title">@ViewData["Title"]</h4>
                        <div class="ml-auto text-right">
                            <nav aria-label="breadcrumb">
                                <ol class="breadcrumb" id="panelBreadcrumb">
                                    <li class="breadcrumb-item"><a href="@homeUrl"><i class="mdi mdi-home"></i> @panelTitle</a></li>
                                </ol>
                            </nav>
                        </div>
                    </div>
                </div>
            </div>
            <div class="container-fluid">
                @RenderBody()
            </div>
            <footer class="footer text-center">
                © @DateTime.Now.Year OnlineEdu · Mert Admin. Tüm hakları saklıdır. Tasarım ve geliştirme: <strong>Mert</strong>
            </footer>
        </div>
    </div>

    <script src="~/matrix-admin-master/assets/libs/jquery/dist/jquery.min.js"></script>
    <script src="~/matrix-admin-master/assets/libs/popper.js/dist/umd/popper.min.js"></script>
    <script src="~/matrix-admin-master/assets/libs/bootstrap/dist/js/bootstrap.min.js"></script>
    <script src="~/matrix-admin-master/assets/libs/perfect-scrollbar/dist/perfect-scrollbar.jquery.min.js"></script>
    <script src="~/matrix-admin-master/assets/extra-libs/sparkline/sparkline.js"></script>
    <script src="~/matrix-admin-master/dist/js/waves.js"></script>
    <script src="~/matrix-admin-master/dist/js/sidebarmenu.js"></script>
    <script src="~/matrix-admin-master/dist/js/custom.min.js"></script>
    <script src="~/matrix-admin-master/assets/libs/magnific-popup/dist/jquery.magnific-popup.min.js"></script>
    <script src="~/matrix-admin-master/assets/libs/magnific-popup/meg.init.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script>
        window.panelSearchItems = @Html.Raw(searchJson);
        window.panelPageTitle = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewData["Title"]?.ToString() ?? ""));
    </script>
    <script src="~/js/panel.js" asp-append-version="true"></script>
</body>
</html>
