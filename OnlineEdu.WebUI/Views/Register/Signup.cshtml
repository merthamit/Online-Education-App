@model UserRegisterDto
@{
    ViewData["Title"] = "Kayıt Ol";
    Layout = "~/Views/UILayout/Layout.cshtml";
}

<section class="oe-auth">
    <div class="container">
        <div class="oe-auth-card">
            <div class="oe-auth-side">
                <h2>OnlineEdu'ya katılın</h2>
                <p>Ücretsiz hesabınızı oluşturun, kurslara kayıt olun ve kendi hızınızda öğrenmeye başlayın.</p>
                <ul class="oe-auth-benefits">
                    <li><i class="fas fa-check-circle"></i> Uzman eğitmenlerden kurslar</li>
                    <li><i class="fas fa-check-circle"></i> Dilediğiniz zaman, dilediğiniz cihazdan erişim</li>
                    <li><i class="fas fa-check-circle"></i> Blog yazılarına yorum yapabilme</li>
                </ul>
                <img src="~/login-form-07/images/undraw_remotely_2j6y.svg" alt="" class="oe-auth-illustration">
            </div>

            <div class="oe-auth-form">
                <h3>Kayıt Ol</h3>
                <p class="oe-auth-sub">Zaten hesabınız var mı? <a href="/Login/SignIn">Giriş yapın</a></p>

                <form method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="oe-auth-alert"></div>

                    <div class="row">
                        <div class="col-sm-6">
                            <div class="oe-field">
                                <label asp-for="FirstName">Ad</label>
                                <div class="oe-input"><i class="fas fa-user"></i><input asp-for="FirstName" placeholder="Adınız" autocomplete="given-name"></div>
                                <span asp-validation-for="FirstName" class="oe-field-error"></span>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="oe-field">
                                <label asp-for="LastName">Soyad</label>
                                <div class="oe-input"><i class="fas fa-user"></i><input asp-for="LastName" placeholder="Soyadınız" autocomplete="family-name"></div>
                                <span asp-validation-for="LastName" class="oe-field-error"></span>
                            </div>
                        </div>
                    </div>

                    <div class="oe-field">
                        <label asp-for="Email">E-posta</label>
                        <div class="oe-input"><i class="fas fa-envelope"></i><input asp-for="Email" type="email" placeholder="ornek@mail.com" autocomplete="email"></div>
                        <span asp-validation-for="Email" class="oe-field-error"></span>
                    </div>

                    <div class="oe-field">
                        <label asp-for="UserName">Kullanıcı Adı</label>
                        <div class="oe-input"><i class="fas fa-at"></i><input asp-for="UserName" placeholder="ornek: ahmet.yilmaz" autocomplete="username"></div>
                        <span asp-validation-for="UserName" class="oe-field-error"></span>
                    </div>

                    <div class="oe-field">
                        <label asp-for="Password">Şifre</label>
                        <div class="oe-input">
                            <i class="fas fa-lock"></i>
                            <input asp-for="Password" type="password" placeholder="Şifrenizi belirleyin" autocomplete="new-password" data-password-rules="pwRules">
                            <button type="button" class="oe-toggle-pw" aria-label="Şifreyi göster"><i class="far fa-eye"></i></button>
                        </div>
                        <span asp-validation-for="Password" class="oe-field-error"></span>
                        <ul class="oe-pw-rules" id="pwRules">
                            <li data-rule="length">En az 6 karakter</li>
                            <li data-rule="upper">Bir büyük harf</li>
                            <li data-rule="lower">Bir küçük harf</li>
                            <li data-rule="digit">Bir rakam</li>
                            <li data-rule="special">Bir özel karakter (! * ? @@ gibi)</li>
                        </ul>
                    </div>

                    <div class="oe-field">
                        <label asp-for="ConfirmPassword">Şifre Tekrarı</label>
                        <div class="oe-input">
                            <i class="fas fa-lock"></i>
                            <input asp-for="ConfirmPassword" type="password" placeholder="Şifrenizi tekrar girin" autocomplete="new-password" data-match="Password">
                            <button type="button" class="oe-toggle-pw" aria-label="Şifreyi göster"><i class="far fa-eye"></i></button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="oe-field-error"></span>
                        <span class="oe-match-hint" id="matchHint"></span>
                    </div>

                    <button type="submit" class="oe-btn oe-auth-submit">Hesabımı Oluştur <i class="fas fa-arrow-right"></i></button>
                </form>
            </div>
        </div>
    </div>
</section>
<script src="~/js/auth.js" asp-append-version="true"></script>
