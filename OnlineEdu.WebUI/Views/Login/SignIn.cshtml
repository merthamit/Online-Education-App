@model UserLoginDto
@{
    ViewData["Title"] = "Giriş Yap";
    Layout = "~/Views/UILayout/Layout.cshtml";
}

<section class="oe-auth">
    <div class="container">
        <div class="oe-auth-card">
            <div class="oe-auth-side">
                <h2>Tekrar hoş geldiniz</h2>
                <p>Hesabınıza giriş yapın, kayıtlı olduğunuz kurslara kaldığınız yerden devam edin.</p>
                <ul class="oe-auth-benefits">
                    <li><i class="fas fa-check-circle"></i> Kayıtlı kurslarınız ve videolarınız</li>
                    <li><i class="fas fa-check-circle"></i> Eğitmen ve öğrenci panelleri</li>
                    <li><i class="fas fa-check-circle"></i> Blog yorumları ve profil ayarları</li>
                </ul>
                <img src="~/login-form-07/images/undraw_remotely_2j6y.svg" alt="" class="oe-auth-illustration">
            </div>

            <div class="oe-auth-form">
                <h3>Giriş Yap</h3>
                <p class="oe-auth-sub">Hesabınız yok mu? <a href="/Register/Signup">Ücretsiz kayıt olun</a></p>

                <form method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="oe-auth-alert"></div>

                    <div class="oe-field">
                        <label asp-for="Email">E-posta</label>
                        <div class="oe-input"><i class="fas fa-envelope"></i><input asp-for="Email" type="email" placeholder="ornek@mail.com" autocomplete="email" autofocus></div>
                        <span asp-validation-for="Email" class="oe-field-error"></span>
                    </div>

                    <div class="oe-field">
                        <label asp-for="Password">Şifre</label>
                        <div class="oe-input">
                            <i class="fas fa-lock"></i>
                            <input asp-for="Password" type="password" placeholder="Şifreniz" autocomplete="current-password">
                            <button type="button" class="oe-toggle-pw" aria-label="Şifreyi göster"><i class="far fa-eye"></i></button>
                        </div>
                        <span asp-validation-for="Password" class="oe-field-error"></span>
                    </div>

                    <button type="submit" class="oe-btn oe-auth-submit">Giriş Yap <i class="fas fa-arrow-right"></i></button>
                </form>
            </div>
        </div>
    </div>
</section>
<script src="~/js/auth.js" asp-append-version="true"></script>
