@model ResultBlogDto
@{
    ViewData["Title"] = "BlogDetails";
    Layout = "~/Views/UILayout/Layout.cshtml";
}

<div class="slider-area ">
    <div class="slider-height2 d-flex align-items-center">
        <div class="container">
            <div class="row">
                <div class="col-xl-12">
                    <div class="hero-cap hero-cap2 text-center">
                        <h2>@Model.Title</h2>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Hero End -->
<!--================Blog Area =================-->
<section class="blog_area single-post-area section-padding">
    <div class="container">
        <div class="row">
            <div class="col-lg-8 posts-list">
                <div class="single-post">
                    <div class="feature-img">
                        <img class="img-fluid" src="@Model.ImageUrl" alt="">
                    </div>
                    <div class="blog_details">
                        <h2 style="color: #2d2d2d;">
                            @Model.Title
                        </h2>
                        <ul class="blog-info-link mt-3 mb-4">
                            <li><a href="@(Model.WriterId != null ? "/Course/Index?teacher=" + Model.WriterId : "#")"><i class="fa fa-user"></i> @(Model.Writer != null ? Model.Writer.FirstName + " " + Model.Writer.LastName : "Yazar Yok")</a></li>
                            <li><a href="#"><i class="fa fa-list"></i> @(Model.BlogCategory != null ? Model.BlogCategory.Name : "Kategori Yok")</a></li>
                        </ul>
                        <p class="excert">
                            @Model.Content
                        </p>




                    </div>
                </div>
                <div class="navigation-top">
                    <div class="d-sm-flex justify-content-between align-items-center text-center">
                        <p class="oe-comment-count mb-0">
                            <i class="fa fa-comments"></i> @((ViewBag.Comments as List<OnlineEdu.WebUI.DTOs.BlogCommentDtos.ResultBlogCommentDto>)?.Count ?? 0) yorum
                        </p>
                        <ul class="social-icons">
                            @foreach (var item in Model.Writer?.TeacherSocials ?? new List<OnlineEdu.WebUI.DTOs.TeacherSocialDtos.ResultTeacherSocialDto>())
                            {
                                <li><a href="@item.Url" target="_blank"><i class="@item.Icon"></i></a></li>
                            }
                        </ul>
                    </div>
                    @{
                        var prevBlog = ViewBag.PrevBlog as ResultBlogDto;
                        var nextBlog = ViewBag.NextBlog as ResultBlogDto;
                    }
                    @if (prevBlog != null || nextBlog != null)
                    {
                        <div class="oe-post-nav">
                            @if (prevBlog != null)
                            {
                                <a href="/Blog/BlogDetails/@prevBlog.BlogId" class="prev">
                                    <img src="@prevBlog.ImageUrl" alt="">
                                    <div>
                                        <small><i class="ti-arrow-left"></i> Önceki Yazı</small>
                                        <span class="title">@prevBlog.Title</span>
                                    </div>
                                </a>
                            }
                            else
                            {
                                <div class="placeholder"></div>
                            }
                            @if (nextBlog != null)
                            {
                                <a href="/Blog/BlogDetails/@nextBlog.BlogId" class="next">
                                    <img src="@nextBlog.ImageUrl" alt="">
                                    <div>
                                        <small>Sonraki Yazı <i class="ti-arrow-right"></i></small>
                                        <span class="title">@nextBlog.Title</span>
                                    </div>
                                </a>
                            }
                            else
                            {
                                <div class="placeholder"></div>
                            }
                        </div>
                    }
                </div>
                <div class="blog-author">
                    <div class="media align-items-center">
                        <a href="@(Model.WriterId != null ? "/Course/Index?teacher=" + Model.WriterId : "#")"><img src="@(Model.Writer?.ImageUrl ?? "https://cdn-icons-png.flaticon.com/512/6621/6621964.png")" alt=""></a>
                        <div class="media-body">
                            <a href="#">
                                <h4><a href="@(Model.WriterId != null ? "/Course/Index?teacher=" + Model.WriterId : "#")">@(Model.Writer != null ? Model.Writer.FirstName + " " + Model.Writer.LastName : "Yazar Yok")</a></h4>
                            </a>
                            <p>
                                @(Model.Writer != null ? Model.Writer.Email : "")
                            </p>
                        </div>
                    </div>
                </div>
                <div class="comments-area">
                    @{
                        var comments = ViewBag.Comments as List<OnlineEdu.WebUI.DTOs.BlogCommentDtos.ResultBlogCommentDto>;
                        int count = comments != null ? comments.Count : 0;
                    }
                    <h4>@count Yorum</h4>
                    
                    @if (comments != null)
                    {
                        foreach(var comment in comments)
                        {
                            <div class="comment-list">
                                <div class="single-comment justify-content-between d-flex">
                                    <div class="user justify-content-between d-flex">
                                        <div class="desc">
                                            <p class="comment">
                                                @comment.Content
                                            </p>
                                            <div class="d-flex justify-content-between">
                                                <div class="d-flex align-items-center">
                                                    <h5>
                                                        <a href="#">@comment.Name</a>
                                                    </h5>
                                                    <p class="date">@comment.CommentDate.ToString("dd MMM yyyy HH:mm")</p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
                <div class="comment-form">
                    <h4>Yorum Yap</h4>
                    @if (User.Identity.IsAuthenticated)
                    {
                        var commenterName = User.Claims.FirstOrDefault(x => x.Type == "fullName")?.Value ?? User.Identity.Name;
                        <p class="mb-3"><i class="fa fa-user"></i> <strong>@commenterName</strong> olarak yorum yapıyorsunuz.</p>
                        <form class="form-contact comment_form" asp-action="AddComment" asp-controller="Blog" method="post">
                            <input type="hidden" name="BlogId" value="@Model.BlogId" />
                            <div class="form-group">
                                <textarea class="form-control w-100" name="Content" id="comment" cols="30" rows="7"
                                          placeholder="Yorumunuzu yazın" required></textarea>
                            </div>
                            <div class="form-group">
                                <button type="submit" class="button button-contactForm btn_1 boxed-btn">Yorumu Gönder</button>
                            </div>
                        </form>
                    }
                    else
                    {
                        var returnUrl = Uri.EscapeDataString("/Blog/BlogDetails/" + Model.BlogId);
                        <div class="alert alert-warning" role="alert" style="padding: 25px;">
                            <h5 style="color: #856404;"><i class="fa fa-lock"></i> Yorum yapabilmek için üye olmanız gerekiyor</h5>
                            <p class="mb-3" style="color: #856404;">Bu bloga yorum bırakmak için lütfen üye olun veya hesabınıza giriş yapın.</p>
                            <a href="/Register/Signup" class="btn btn-primary mr-2">Üye Ol</a>
                            <a href="/Login/SignIn?returnUrl=@returnUrl" class="btn btn-outline-primary">Giriş Yap</a>
                        </div>
                    }
                </div>
            </div>
            <div class="col-lg-4">
                <div class="blog_right_sidebar">
                    <partial name="_BlogSearch" />
                    @await Component.InvokeAsync("_BlogCategoryList")
                    @await Component.InvokeAsync("_BlogRecentBlogs")

                    <aside class="single_sidebar_widget instagram_feeds">
                        <h4 class="widget_title" style="color: #2d2d2d;">Instagram Feeds</h4>
                        <ul class="instagram_row flex-wrap">
                            <li>
                                <a href="#">
                                    <img class="img-fluid" src="assets/img/post/post_5.png" alt="">
                                </a>
                            </li>
                            <li>
                                <a href="#">
                                    <img class="img-fluid" src="assets/img/post/post_6.png" alt="">
                                </a>
                            </li>
                            <li>
                                <a href="#">
                                    <img class="img-fluid" src="assets/img/post/post_7.png" alt="">
                                </a>
                            </li>
                            <li>
                                <a href="#">
                                    <img class="img-fluid" src="assets/img/post/post_8.png" alt="">
                                </a>
                            </li>
                            <li>
                                <a href="#">
                                    <img class="img-fluid" src="assets/img/post/post_9.png" alt="">
                                </a>
                            </li>
                            <li>
                                <a href="#">
                                    <img class="img-fluid" src="assets/img/post/post_10.png" alt="">
                                </a>
                            </li>
                        </ul>
                    </aside>
                    @await Component.InvokeAsync("_BlogSubscribe")
                </div>
            </div>
        </div>
    </div>
</section>

