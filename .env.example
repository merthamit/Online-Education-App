# Bu dosyayı .env adıyla kopyalayıp kendi değerlerinizi girin:
#   cp .env.example .env
# SQL Server şifresi: en az 8 karakter, büyük/küçük harf, rakam ve sembol içermeli
SQL_SA_PASSWORD=Your_Strong_Password_123!
# JWT imzalama anahtarı: en az 32 karakterlik rastgele bir metin
JWT_KEY=buraya-en-az-32-karakterlik-rastgele-bir-anahtar-yazin
# Cloudinary (https://console.cloudinary.com > Dashboard)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
